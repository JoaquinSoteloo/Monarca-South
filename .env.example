# Supabase (público — se usan desde el navegador, no son secretos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pulse Grow — SOLO server-side. NUNCA agregar el prefijo NEXT_PUBLIC_ a esta
# variable: se usa exclusivamente dentro de app/api/pulse/** y nunca debe
# llegar al navegador. Se genera en la app de Pulse: Settings > API > Add API Key.
PULSE_GROW_API_KEY=

# Automatizaciones — SOLO server-side. Secret que debe mandar (como
# "Authorization: Bearer <valor>") quien invoque POST /api/automations/evaluate
# desde afuera (ej. un pinger externo tipo cron-job.org, cada 1 minuto).
# Generar un valor random largo, ej: openssl rand -hex 32
AUTOMATIONS_CRON_SECRET=

# Web Push (VAPID). La pública se expone al navegador para suscribirse; la
# privada es SOLO server-side y firma los envíos. Generar el par con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joacosotelo11@gmail.com

# Cliente Supabase con permisos elevados — SOLO server-side, NUNCA
# NEXT_PUBLIC_. Lo usa lib/supabase/service.ts porque push_subscriptions
# tiene RLS cerrada para anon/authenticated (a diferencia del resto de las
# tablas del proyecto). Se obtiene en Supabase: Project Settings > API >
# service_role key.
SUPABASE_SERVICE_ROLE_KEY=
